# ============================================================
# .gitignore – RMS Hosting Tester
# ============================================================

# -- Environment / secrets (NEVER commit these) --
.env
.env.local
.env.development
.env.test
.env.production
*.env

# -- Dependencies --
node_modules/

# -- Logs --
*.log
logs/
passenger.log
error_log
access_log

# -- cPanel / Passenger runtime files --
.cpanel/
.htaccess.bak
tmp/
temp/

# -- OS files --
.DS_Store
Thumbs.db

# -- IDE --
.vscode/
.idea/
*.swp
*.swo

# -- Test output --
load-test-results.json
performance-data.json
reports/

# -- SSL --
*.pem
*.key
*.cert
*.crt

# -- Misc --
*.bak
*.backup
*.tgz
coverage/
dist/
build/
