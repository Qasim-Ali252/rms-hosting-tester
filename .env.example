# ============================================================
# .env.example – RMS Hosting Tester
# ============================================================
# Copy this file to .env and fill in your actual credentials.
#   cp .env.example .env
#
# NEVER commit the .env file. It is listed in .gitignore.
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=3000

# ---- Database ----
# cPanel format: DB_USER = cpanelusername_dbuser
#                DB_NAME = cpanelusername_dbname
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# ---- Security ----
# Any non-empty string.  Used only for the /env-test endpoint.
# The real value is NEVER returned by the API.
TEST_SECRET=
